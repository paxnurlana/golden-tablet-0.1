{
  "name": "@golden-tablet/journal-importers",
  "version": "0.1.0",
  "description": "Statement and export importers for the trade journal: broker CSVs, MetaTrader HTML statements, and one-click migration from TradeZella and Tradervue.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "trading",
    "trade-journal",
    "csv",
    "import",
    "tradezella",
    "tradervue",
    "broker-statement"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "dependencies": {
    "@golden-tablet/journal-core": "workspace:*"
  },
  "private": true
}
