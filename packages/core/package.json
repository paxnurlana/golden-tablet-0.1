{
  "name": "@golden-tablet/journal-core",
  "version": "0.1.0",
  "description": "Pure trade-journal domain engine: round-trip matching, performance metrics, aggregations, equity curves, and the open Edge Score. No IO, no framework.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "trading",
    "trade-journal",
    "pnl",
    "fifo",
    "round-trip",
    "expectancy",
    "drawdown"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "private": true
}
